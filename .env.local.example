# Copy this file to .env.local (already git-ignored) and fill in your key
# to enable live market data in the homepage ticker.
#
# Get a free API key at https://finnhub.io/register (free tier covers this
# ticker's usage comfortably — quotes are cached for 5 minutes).
#
# Without this variable set, the ticker falls back to labelled sample data.
FINNHUB_API_KEY=
